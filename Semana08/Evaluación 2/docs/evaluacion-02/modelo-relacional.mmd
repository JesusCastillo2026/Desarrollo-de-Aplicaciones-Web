erDiagram
    ROLES ||--o{ USUARIOS : asigna
    PACIENTES ||--o{ SOLICITUD_CIRUGIA : paciente
    MEDICOS ||--o{ SOLICITUD_CIRUGIA : solicita
    HISTORIA_CLINICA ||--o{ SOLICITUD_CIRUGIA : referencia
    SOLICITUD_CIRUGIA ||--o{ EVALUACIONES_PREOPERATORIAS : recibe
    MEDICOS ||--o{ EVALUACIONES_PREOPERATORIAS : evalua
    SOLICITUD_CIRUGIA ||--o{ APROBACIONES_CIRUGIA : decision
    SOLICITUD_CIRUGIA ||--o{ PROGRAMACIONES_CIRUGIA : agenda
    QUIROFANOS ||--o{ PROGRAMACIONES_CIRUGIA : ocupa
    MEDICOS ||--o{ PROGRAMACIONES_CIRUGIA : cirujano
    MEDICOS ||--o{ PROGRAMACIONES_CIRUGIA : anestesiologo
