{
  "info": {
    "name": "Laboratorio 11 - Microservicios",
    "description": "Flujos de prueba para la guía de tienda y la actividad clínica. Variables iniciales apuntan a localhost; ejecute cada servicio antes de su carpeta de solicitudes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"categoriaUrl","value":"http://localhost:8082"},
    {"key":"clienteUrl","value":"http://localhost:8081"},
    {"key":"productoUrl","value":"http://localhost:8083"},
    {"key":"pedidoUrl","value":"http://localhost:8084"},
    {"key":"pacienteUrl","value":"http://localhost:8091"},
    {"key":"medicoUrl","value":"http://localhost:8092"},
    {"key":"citaUrl","value":"http://localhost:8093"},
    {"key":"categoriaId","value":"1"},
    {"key":"clienteId","value":"1"},
    {"key":"productoId","value":"1"},
    {"key":"pedidoId","value":"1"},
    {"key":"pacienteId","value":"1"},
    {"key":"especialidadId","value":"1"},
    {"key":"medicoId","value":"1"},
    {"key":"citaId","value":"1"}
  ],
  "item": [
    {
      "name":"Tienda (ejercicio guía)",
      "item":[
        {"name":"Crear categoría","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Medicamentos\",\n  \"estado\": \"ACTIVO\"\n}"},"url":"{{categoriaUrl}}/api/categorias"},"event":[{"listen":"test","script":{"exec":["pm.test('Categoría creada (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('categoriaId', pm.response.json().id);"]}}]},
        {"name":"Crear cliente","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Torres Rojas\",\n  \"direccion\": \"Av. Central 123\",\n  \"telefono\": \"987654321\",\n  \"nroDni\": \"12345678\",\n  \"estado\": \"ACTIVO\"\n}"},"url":"{{clienteUrl}}/api/clientes"},"event":[{"listen":"test","script":{"exec":["pm.test('Cliente creado (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('clienteId', pm.response.json().id);"]}}]},
        {"name":"Crear producto asociado a categoría","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Producto de prueba\",\n  \"precio\": 12.50,\n  \"stock\": 20,\n  \"categoriaId\": {{categoriaId}}\n}"},"url":"{{productoUrl}}/api/productos"},"event":[{"listen":"test","script":{"exec":["pm.test('Producto creado (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('productoId', pm.response.json().id);"]}}]},
        {"name":"Crear pedido con referencias remotas","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"fecha\": \"2026-11-09\",\n  \"idCliente\": {{clienteId}},\n  \"detalles\": [{\n    \"idProducto\": {{productoId}},\n    \"cantidad\": 2,\n    \"precio\": 12.50\n  }]\n}"},"url":"{{pedidoUrl}}/api/pedidos"},"event":[{"listen":"test","script":{"exec":["pm.test('Pedido creado (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('pedidoId', pm.response.json().id);","if (pm.response.code === 201) pm.test('Total calculado', () => pm.expect(Number(pm.response.json().total)).to.eql(25));"]}}]},
        {"name":"Listar pedidos","request":{"method":"GET","url":"{{pedidoUrl}}/api/pedidos"},"event":[{"listen":"test","script":{"exec":["pm.test('Lista de pedidos (200)', () => pm.response.to.have.status(200));"]}}]},
        {"name":"Rechazar categoría inexistente al crear producto","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Sin categoría\",\n  \"precio\": 5.00,\n  \"stock\": 1,\n  \"categoriaId\": 999999\n}"},"url":"{{productoUrl}}/api/productos"},"event":[{"listen":"test","script":{"exec":["pm.test('Referencia inválida rechazada (400)', () => pm.response.to.have.status(400));"]}}]}
      ]
    },
    {
      "name":"Clínica Salud Integral (actividad final)",
      "item":[
        {"name":"Crear paciente","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"dni\": \"87654321\",\n  \"nombres\": \"Lucía\",\n  \"apellidos\": \"Pérez Soto\",\n  \"fechaNacimiento\": \"1995-04-20\",\n  \"sexo\": \"F\",\n  \"telefono\": \"987123456\",\n  \"direccion\": \"Jr. Los Olivos 456\",\n  \"correo\": \"lucia.perez@example.com\",\n  \"estado\": \"A\"\n}"},"url":"{{pacienteUrl}}/api/pacientes"},"event":[{"listen":"test","script":{"exec":["pm.test('Paciente creado (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('pacienteId', pm.response.json().id);"]}}]},
        {"name":"Consultar paciente por ID","request":{"method":"GET","url":"{{pacienteUrl}}/api/pacientes/{{pacienteId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Paciente encontrado (200)', () => pm.response.to.have.status(200));"]}}]},
        {"name":"Actualizar paciente","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"dni\": \"87654321\",\n  \"nombres\": \"Lucía María\",\n  \"apellidos\": \"Pérez Soto\",\n  \"fechaNacimiento\": \"1995-04-20\",\n  \"sexo\": \"F\",\n  \"telefono\": \"987123457\",\n  \"direccion\": \"Jr. Los Olivos 456\",\n  \"correo\": \"lucia.perez@example.com\",\n  \"estado\": \"A\"\n}"},"url":"{{pacienteUrl}}/api/pacientes/{{pacienteId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Paciente actualizado (200)', () => pm.response.to.have.status(200));"]}}]},
        {"name":"Crear especialidad","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Medicina general\",\n  \"descripcion\": \"Atención primaria\",\n  \"estado\": \"A\"\n}"},"url":"{{medicoUrl}}/api/especialidades"},"event":[{"listen":"test","script":{"exec":["pm.test('Especialidad creada (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('especialidadId', pm.response.json().id);"]}}]},
        {"name":"Crear médico relacionado a especialidad","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"cmp\": \"CMP12345\",\n  \"nombres\": \"Carlos\",\n  \"apellidos\": \"Ramos León\",\n  \"telefono\": \"987654321\",\n  \"correo\": \"carlos.ramos@example.com\",\n  \"idEspecialidad\": {{especialidadId}},\n  \"estado\": \"A\"\n}"},"url":"{{medicoUrl}}/api/medicos"},"event":[{"listen":"test","script":{"exec":["pm.test('Médico creado (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('medicoId', pm.response.json().id);"]}}]},
        {"name":"Consultar médico por ID","request":{"method":"GET","url":"{{medicoUrl}}/api/medicos/{{medicoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Médico encontrado (200)', () => pm.response.to.have.status(200));"]}}]},
        {"name":"Actualizar médico","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"cmp\": \"CMP12345\",\n  \"nombres\": \"Carlos Alberto\",\n  \"apellidos\": \"Ramos León\",\n  \"telefono\": \"987654320\",\n  \"correo\": \"carlos.ramos@example.com\",\n  \"idEspecialidad\": {{especialidadId}},\n  \"estado\": \"A\"\n}"},"url":"{{medicoUrl}}/api/medicos/{{medicoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Médico actualizado (200)', () => pm.response.to.have.status(200));"]}}]},
        {"name":"Crear horario médico","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"idMedico\": {{medicoId}},\n  \"diaSemana\": \"LUNES\",\n  \"horaInicio\": \"08:00:00\",\n  \"horaFin\": \"12:00:00\"\n}"},"url":"{{medicoUrl}}/api/horarios"},"event":[{"listen":"test","script":{"exec":["pm.test('Horario creado (201)', () => pm.response.to.have.status(201));"]}}]},
        {"name":"Crear cita con paciente y médico existentes","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"fecha\": \"2026-11-16\",\n  \"hora\": \"09:30:00\",\n  \"idPaciente\": {{pacienteId}},\n  \"idMedico\": {{medicoId}},\n  \"motivo\": \"Consulta general de control\"\n}"},"url":"{{citaUrl}}/api/citas"},"event":[{"listen":"test","script":{"exec":["pm.test('Cita creada (201)', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('citaId', pm.response.json().id);"]}}]},
        {"name":"Consultar cita por ID","request":{"method":"GET","url":"{{citaUrl}}/api/citas/{{citaId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Cita encontrada (200)', () => pm.response.to.have.status(200));"]}}]},
        {"name":"Confirmar cita","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"estado\": \"CONFIRMADA\"\n}"},"url":"{{citaUrl}}/api/citas/{{citaId}}/estado"},"event":[{"listen":"test","script":{"exec":["pm.test('Cita confirmada (200)', () => pm.response.to.have.status(200));","pm.test('Estado actualizado', () => pm.expect(pm.response.json().estado).to.eql('CONFIRMADA'));"]}}]},
        {"name":"Registrar atención y marcar atendida","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"diagnostico\": \"Control preventivo\",\n  \"tratamiento\": \"Seguir indicaciones médicas\",\n  \"observaciones\": \"Nueva evaluación en seis meses\"\n}"},"url":"{{citaUrl}}/api/citas/{{citaId}}/atencion"},"event":[{"listen":"test","script":{"exec":["pm.test('Atención registrada (200)', () => pm.response.to.have.status(200));","pm.test('Respuesta tiene datos clínicos', () => pm.expect(pm.response.json().diagnostico).to.be.a('string'));"]}}]},
        {"name":"Consultar atención","request":{"method":"GET","url":"{{citaUrl}}/api/citas/{{citaId}}/atencion"},"event":[{"listen":"test","script":{"exec":["pm.test('Atención consultada (200)', () => pm.response.to.have.status(200));"]}}]},
        {"name":"Cancelar cita","request":{"method":"POST","url":"{{citaUrl}}/api/citas/{{citaId}}/cancelar"},"event":[{"listen":"test","script":{"exec":["pm.test('Cita cancelada (200)', () => pm.response.to.have.status(200));","pm.test('Estado cancelado', () => pm.expect(pm.response.json().estado).to.eql('CANCELADA'));"]}}]},
        {"name":"Rechazar DNI inválido","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"dni\": \"123\",\n  \"nombres\": \"Dato inválido\",\n  \"apellidos\": \"Prueba\",\n  \"fechaNacimiento\": \"1990-01-01\",\n  \"sexo\": \"F\",\n  \"telefono\": \"987123456\",\n  \"direccion\": \"Dirección\",\n  \"correo\": \"incorrecto\",\n  \"estado\": \"A\"\n}"},"url":"{{pacienteUrl}}/api/pacientes"},"event":[{"listen":"test","script":{"exec":["pm.test('Validación rechaza datos (400)', () => pm.response.to.have.status(400));"]}}]},
        {"name":"Rechazar cita con paciente inexistente","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"fecha\": \"2026-11-16\",\n  \"hora\": \"10:00:00\",\n  \"idPaciente\": 999999,\n  \"idMedico\": {{medicoId}},\n  \"motivo\": \"Prueba de referencia incorrecta\"\n}"},"url":"{{citaUrl}}/api/citas"},"event":[{"listen":"test","script":{"exec":["pm.test('Referencia remota rechazada (400)', () => pm.response.to.have.status(400));"]}}]}
      ]
    }
  ]
}
