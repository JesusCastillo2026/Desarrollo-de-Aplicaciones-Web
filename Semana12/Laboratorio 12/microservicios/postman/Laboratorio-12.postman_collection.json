              "const d=pm.response.json(); pm.collectionVariables.set('pedidoId', d.id); pm.expect(d.cliente.id).to.eql(Number(pm.collectionVariables.get('clienteId'))); pm.expect(d.detalles[0].producto.id).to.eql(Number(pm.collectionVariables.get('productoId'))); pm.expect(d.total).to.eql(5000);"
            ]
