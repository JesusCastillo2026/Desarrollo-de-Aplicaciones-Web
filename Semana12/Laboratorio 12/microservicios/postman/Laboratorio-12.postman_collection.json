  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testDni')) { pm.collectionVariables.set('testDni', String(Date.now()).slice(-8)); }"
        ]
      }
    }
  ],
