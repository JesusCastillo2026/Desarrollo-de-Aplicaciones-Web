            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8761/eureka/apps",
          "host": [
            "localhost:8761"
          ],
          "path": [
            "eureka",
            "apps"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01 - Verificar Eureka: HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.text()).to.include('applications');"
